{
    "site": {
        "name": "CampusAlert",
        "institution": "St. Columban College",
        "tagline": "Premier University Campus Security and Maintenance Portal",
        "version": "1.0.0",
        "lastUpdated": "2026-09-03"
    },
    "branding": {
        "logo": {
            "title": "CampusAlert",
            "subtitle": "St. Columban College"
        },
        "colors": {
            "primary": {
                "forestGreen900": "#0D3311",
                "forestGreen800": "#1B5E20",
                "forestGreen700": "#2E7D32",
                "forestGreen600": "#388E3C",
                "forestGreen500": "#43A047",
                "forestGreen400": "#66BB6A"
            },
            "accent": {
                "sageGreen": "#A5D6A7",
                "sageGreenLight": "#C8E6C9",
                "offWhite": "#FAFAFA",
                "offWhiteWarm": "#F5F5F0"
            },
            "emergency": {
                "signalRed": "#D32F2F",
                "signalRedDark": "#B71C1C"
            }
        },
        "typography": {
            "fontFamily": "Poppins",
            "weights": [300, 400, 500, 600, 700],
            "fallbacks": "-apple-system, BlinkMacSystemFont, sans-serif"
        }
    },
    "navigation": {
        "links": [
            {
                "label": "Home",
                "url": "#",
                "active": true
            },
            {
                "label": "Security",
                "url": "#security",
                "active": false
            },
            {
                "label": "Maintenance",
                "url": "#maintenance",
                "active": false
            },
            {
                "label": "Emergency",
                "url": "#emergency",
                "active": false
            }
        ]
    },
    "auth": {
        "providers": [
            {
                "id": "email",
                "type": "credentials",
                "label": "Email & Password",
                "enabled": true
            },
            {
                "id": "google",
                "type": "oauth",
                "label": "Google",
                "icon": "google",
                "enabled": true
            }
        ],
        "fields": {
            "email": {
                "label": "Email Address",
                "placeholder": "student@stcolumban.edu.ph",
                "type": "email",
                "required": true,
                "autocomplete": "email"
            },
            "password": {
                "label": "Password",
                "placeholder": "Enter your password",
                "type": "password",
                "required": true,
                "autocomplete": "current-password"
            }
        },
        "options": {
            "rememberMe": {
                "enabled": true,
                "label": "Remember me"
            },
            "forgotPassword": {
                "enabled": true,
                "label": "Forgot password?",
                "url": "#forgot"
            }
        }
    },
    "background": {
        "image": "https://images.unsplash.com/photo-1562774053-701939374585?w=1920&q=80",
        "kenBurns": {
            "enabled": true,
            "duration": "30s"
        },
        "weather": {
            "rain": {
                "enabled": true,
                "dropCount": 100
            },
            "heatHaze": {
                "enabled": true,
                "duration": "4s"
            }
        },
        "gradient": {
            "enabled": true,
            "color": "#1B5E20"
        }
    },
    "animations": {
        "parallax": {
            "enabled": true,
            "intensity": 8
        },
        "borderGlow": {
            "enabled": true,
            "duration": "4s"
        },
        "notificationJiggle": {
            "enabled": true,
            "interval": 15000,
            "duration": "0.5s"
        },
        "formLoading": {
            "enabled": true,
            "duration": 2000
        }
    },
    "ui": {
        "loading": {
            "enabled": true,
            "duration": 1500
        },
        "statusBar": {
            "enabled": true,
            "text": "All Systems Operational"
        },
        "toast": {
            "duration": 4000,
            "position": "top-right"
        }
    },
    "footer": {
        "signup": {
            "text": "Don't have an account?",
            "link": {
                "label": "Request Access",
                "url": "#"
            }
        }
    }
}
