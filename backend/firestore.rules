rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------------
    // Helper functions
    // ---------------------------------------------------------------------------
    function isAuthenticated() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (request.auth.token.admin == true ||
         get(/databases/$(database)/documents/users/$(uid())).data.role == 'admin');
    }

    function isDispatcher() {
      return isAuthenticated() &&
        (request.auth.token.dispatcher == true ||
         request.auth.token.soc_operator == true ||
         request.auth.token.admin == true);
    }

    function hasMfaEnrolled() {
      return request.auth.token.mfaEnrolled == true;
    }

    function isCriticalAlert(record) {
      return record.data.severity == 'CRITICAL';
    }

    // ---------------------------------------------------------------------------
    // Users
    // ---------------------------------------------------------------------------
    match /users/{userId} {
      // Users can read their own profile.
      allow read: if isAuthenticated() && uid() == userId;
      // Admins can list and read any user.
      allow list: if isAdmin();
      // Users can write limited fields (device tokens, preferences).
      // The role and institution claims come from Auth custom claims, not here.
      allow write: if isAuthenticated() && uid() == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['role', 'institutionId', 'permissions']);

      // Admins manage the rest of the user document.
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false; // Never delete user records (compliance)
    }

    // ---------------------------------------------------------------------------
    // Zones
    // ---------------------------------------------------------------------------
    match /zones/{zoneId} {
      // Zones are readable by all authenticated users.
      allow read: if isAuthenticated();
      // Only dispatchers can update zone status during an incident.
      allow update: if isDispatcher() && hasMfaEnrolled()
        && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['active', 'status', 'lastUpdatedBy', 'lastUpdatedAt']);
      // Zone creation and deletion is restricted to admins.
      allow create, delete: if isAdmin();
    }

    // ---------------------------------------------------------------------------
    // Emergency Alerts — append-only for dispatchers
    // ---------------------------------------------------------------------------
    match /emergency_alerts/{alertId} {
      // Read: any authenticated user in the institution can see active alerts.
      allow read: if isAuthenticated();
      // Write: only dispatchers, immutable after creation (no updates or deletes).
      allow create: if isDispatcher() && hasMfaEnrolled();
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------------------
    // Audit Log — completely append-only, no read for non-admins
    // ---------------------------------------------------------------------------
    match /emergency_audit_log/{alertId} {
      // No client-side reads — this is for post-incident admin review.
      allow read: if isAdmin();
      // Write: only dispatchers (the Cloud Function writes, but we also enforce
      // at the rules level in case a function call is forged).
      allow create: if isDispatcher() && hasMfaEnrolled();
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------------------
    // Critical Approvals — for dual-control on CRITICAL alerts
    // ---------------------------------------------------------------------------
    match /critical_approvals/{approvalId} {
      allow read: if isDispatcher();
      allow create: if isDispatcher() && hasMfaEnrolled()
        && !isCriticalAlert(request.resource); // sanity-check guard
      allow update: if false;
      allow delete: if false;
    }

    // ---------------------------------------------------------------------------
    // Emergency Acknowledgments
    // ---------------------------------------------------------------------------
    match /emergency_acknowledgments/{ackId} {
      // A user can read only their own acknowledgments.
      allow read: if isAuthenticated()
        && uid() == resource.data.uid;
      // A user can only write their own acknowledgment.
      allow create: if isAuthenticated() && uid() == request.resource.data.uid;
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------------------
    // Device Subscriptions (topic subscriptions per device)
    // ---------------------------------------------------------------------------
    match /device_subscriptions/{docId} {
      // Users can manage their own subscription record.
      allow read: if isAuthenticated() && uid() == docId;
      allow write: if isAuthenticated() && uid() == docId
        && request.resource.data.uid == uid();
    }

    // ---------------------------------------------------------------------------
    // Emergency Protocols (playbooks — read by all, managed by admins)
    // ---------------------------------------------------------------------------
    match /emergency_protocols/{protocolId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------------------
    // Institutions
    // ---------------------------------------------------------------------------
    match /institutions/{institutionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
